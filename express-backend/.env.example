# 数据库连接
DATABASE_URL="mysql://root:password@localhost:3306/pixelreel"

# 服务监听（默认仅允许本机访问）
PORT=18889
HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:18888,http://127.0.0.1:18888

# JWT 鉴权（启用时密钥至少 32 个字符，密码至少 8 个字符）
JWT_SECRET=
JWT_USERNAME=zaynzhu
JWT_PASSWORD=
# 是否启用 JWT 鉴权（true/false，默认 false）
AUTH_ENABLED=false

# TMDB
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# OMDb
OMDB_API_KEY=
OMDB_BASE_URL=https://www.omdbapi.com

# Trakt
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_ACCESS_TOKEN=
TRAKT_BASE_URL=https://api.trakt.tv
TRAKT_REDIRECT_URI=http://localhost:18889/api/trakt/callback

# 豆瓣
